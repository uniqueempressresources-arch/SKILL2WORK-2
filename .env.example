# Shared
NODE_ENV=development

# API
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://skill2work:skill2work@localhost:5432/skill2work
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000
UPLOAD_DIR=./storage/uploads

# Optional integrations - NEVER put secrets in VITE_* variables
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional AI
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_DAILY_GLOBAL_BUDGET_NGN=0
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=1200

# Worker
WORKER_POLL_MS=5000
